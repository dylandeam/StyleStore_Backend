# Database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/stylestore_db
DATABASE_URL_TEST=postgresql://postgres:your_password_here@localhost:5432/stylestore_db_test

# JWT
SECRET_KEY=generate-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# PayPal Orders v2 (usa credenciales Sandbox o Live reales en despliegues)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
ALLOW_MOCK_PAYPAL=false
PAYPAL_BOB_PER_USD=6.96

# Firebase Admin / FCM push notifications. Configure only one of these.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_B64=

# Optional security and first-run bootstrap values. Never commit real values.
ADMIN_MASTER_KEY=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
